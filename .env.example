# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 默认飞书 Webhook URL（必填，作为 fallback）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 策略专属 Webhook（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<URL>）
# 未配置的策略将自动使用默认 FEISHU_WEBHOOK_URL
STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/your-ma-volume-token
STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/your-turtle-token
STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/your-flag-token
STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/your-shakeout-token
STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/your-limit-down-token
STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/your-rps-token
STRATEGY_WEBHOOK_REGIME=https://open.feishu.cn/open-apis/bot/v2/hook/your-regime-token
STRATEGY_WEBHOOK_FACTORS=https://open.feishu.cn/open-apis/bot/v2/hook/your-factors-token

# 基金研究飞书 Webhook（可选）
FEISHU_ETF_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your-etf-token

# ═══════════════════════════════════════════
# 策略参数（可选，不配置则使用默认值）
# ═══════════════════════════════════════════
TURTLE_BREAK_PERIOD=20
TURTLE_MIN_TURNOVER=100000000
MA_VOLUME_SHORT=5
MA_VOLUME_LONG=20
MA_VOLUME_THRESHOLD=1.5
HIGH_TIGHT_FLAG_MOMENTUM=1.6
HIGH_TIGHT_FLAG_CONSOLIDATION=1.15
RPS_PERIOD=120
RPS_THRESHOLD=90

# ═══════════════════════════════════════════
# 腾讯云 COS 配置（可选）
# ═══════════════════════════════════════════
COS_ENABLED=true
COS_BUCKET=sequoia-recommend-1442452595
COS_REGION=ap-beijing
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key
COS_PATH=/

# ═══════════════════════════════════════════
# 评分权重（可选，格式: 策略名=权重，逗号分隔）
# ═══════════════════════════════════════════
# SCORER_WEIGHTS=maVolume=0.125,turtleTrade=0.125,meanReversion=0.125,volumePrice=0.125,atrChannel=0.125,macdRsi=0.125,maCross=0.125,kdj=0.125
